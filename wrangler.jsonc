/**
 * fortune-gatekeeper（占いMCP）の Wrangler 設定。
 *
 * カード層（POST /mcp）は状態も秘密も持たない直通電話のまま。
 * 占星術層（POST /mcp/<鍵>）だけが KV を 1 本使う ―― 鍵の台帳と、計算済みチャートの置き場。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fortune-gatekeeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  // 占星術層の台帳。key:<鍵> → {user,name,role} と chart:<user>:<chart_id> → 計算済みチャート。
  // ⚠ デプロイ前に `npx wrangler kv namespace create ASTRO_KV` で作成し、
  //    出力された id をここに差し替えること。ローカル dev はこの id を使わない
  //    （`wrangler dev` は .wrangler/state 配下のローカル KV に読み書きする）。
  "kv_namespaces": [
    {
      "binding": "ASTRO_KV",
      "id": "7a7079626493440493fb718744511d80"
    }
  ],
  // 出生の原本（progressions＝二次進行だけが読む）は Secret で渡す。設定ファイルには書かない。
  // ⚠ デプロイ時に `npx wrangler secret put OWNER_NATAL` で原本（JSON 1 行）を入れること。
  //    ローカル dev は .dev.vars（git 管理外）の OWNER_NATAL を読む。
  "dev": {
    // 8788 は vault-gatekeeper が使うので 8789 を借りる
    "port": 8789
  },
  // 公開は my-sky.blue のカスタムドメインのみ（workers.dev の名前は出さない。2026-08-15 決定）。
  // custom_domain は deploy 時に DNS レコードと証明書を自動で作る
  "workers_dev": false,
  "routes": [{ "pattern": "fortune-mcp.my-sky.blue", "custom_domain": true }]
}
