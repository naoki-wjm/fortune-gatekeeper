/**
 * fortune-gatekeeper（占いMCP）の Wrangler 設定。
 *
 * カード層（POST /mcp）は状態も秘密も持たない直通電話のまま。
 * 占星術層は KV を使う ―― メールの許可台帳、計算済みチャートの置き場（ASTRO_KV）。
 * 2026-08-22 に入口を OAuth（POST /astro/mcp）1 本にしたので、
 * OAuth のトークン置き場（OAUTH_KV）と Access の Secret 6 本がここに要る。
 *
 * main が src/worker.ts なのは、そこが OAuth の門を被せた入口だから
 * （門を通らない口はすべて今までどおり src/index.ts のルーターに落ちる）。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fortune-gatekeeper",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // access-handler が JWT の base64url を解くのに node:buffer を使う（手本と同じ実装）
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs は使うが、呼び出しごとの記録（リクエスト URL とヘッダを含む）は残さない ――
  // OAuth の `/callback?code=…` の URL や Authorization: Bearer のトークンが呼び出し記録に
  // 映りうるため。URL 鍵の引退後も据え置き。自前の console 出力だけが残る。2026-08-22、査読対応
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  // CPU の上限（ms）。2026-08-21 に Workers Paid へ移行（Free の名目 10ms では yearly_overview の
  // 実測 15〜42ms が収まらない）。Paid の既定値と同じ 30 秒をここに明示しておく ―― 期間走査系の
  // ツール（年間概要・今後の transit_events）は秒単位の予算で設計してよい、という宣言でもある。
  "limits": {
    "cpu_ms": 30000
  },
  // 占星術層の台帳。email:<SHA-256> → {user,name,role}、
  // chart:<user>:<chart_id> → 計算済みチャート。
  // ⚠ デプロイ前に `npx wrangler kv namespace create ASTRO_KV` で作成し、
  //    出力された id をここに差し替えること。ローカル dev はこの id を使わない
  //    （`wrangler dev` は .wrangler/state 配下のローカル KV に読み書きする）。
  //
  // OAUTH_KV は @cloudflare/workers-oauth-provider がトークンとグラントを置く別棚。
  // 2026-08-22 に作成済み（title: fortune-gatekeeper-OAUTH_KV）。
  "kv_namespaces": [
    {
      "binding": "ASTRO_KV",
      "id": "7a7079626493440493fb718744511d80"
    },
    {
      "binding": "OAUTH_KV",
      "id": "82c148adb45247e4bd28165e934fc112"
    }
  ],
  // Cloudflare Access for SaaS (OIDC) アプリの値と、承認画面のクッキーを署名する鍵。
  // `npx wrangler secret put <名前>` でセッション外の端末から入れる（会話ログに残さない）。
  // 雛形は .dev.vars.example を参照。
  // 公開層（POST /mcp）の連打の見張り（2026-08-27 査読対応。Workers の Rate Limiting バインディング）。
  // 同じ送信元（cf-connecting-ip）から 1 分に 60 回まで。超えたら 429（src/index.ts）。
  // Zone の WAF レート制限ルールは無料枠で 1 本きりで別サイトが使っているため、Worker 側に置く。
  // namespace_id はこの Worker の中で見張りを区別する番号（外で作るものではない）。
  // 鍵つきの入口（/astro/mcp）と OAuth の口はこの枠に入れない。
  //
  // 2 本目は重いツール（reverse_horoscope）専用の枠（2026-08-27 再査読対応）。
  // いちばん重い形（required 1 本 × 10 年）は手元の Node で約 0.1 秒、Workers 実機はその
  // 2〜5 倍なので 0.2〜0.5 秒。60 回/分の枠では 1 人で 1 分ぶんの CPU を使い切れてしまうため、
  // この 1 本だけ 6 回/分に絞る（上の 60 回/分の内側でさらに引く＝両方を通らないと走らない）。
  // 鍵つきの入口（/astro/mcp）から呼ぶぶんは認証済みなので、こちらの枠には入れない。
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "REVERSE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "secrets": {
    "required": [
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY"
    ]
  },
  "dev": {
    // 8788 は vault-gatekeeper が使うので 8789 を借りる
    "port": 8789
  },
  // 公開は my-sky.blue のカスタムドメインのみ（workers.dev の名前は出さない。2026-08-15 決定）。
  // custom_domain は deploy 時に DNS レコードと証明書を自動で作る
  "workers_dev": false,
  "routes": [{ "pattern": "fortune-mcp.my-sky.blue", "custom_domain": true }]
}
